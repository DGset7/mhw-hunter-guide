*{margin:0;padding:0;box-sizing:border-box}
:root{
    --bg-primary:#0f0f1a;--bg-secondary:#1a1a2e;--bg-card:#16213e;
    --bg-card-hover:#1c2a4a;--text-primary:#e0e0e0;--text-secondary:#8a8a9a;
    --accent:#e94560;--accent-glow:rgba(233,69,96,0.3);
    --fire:#ff6b35;--water:#4da6ff;--thunder:#ffd700;--ice:#87ceeb;
    --dragon:#9b59b6;--poison:#8e44ad;--paralysis:#f1c40f;--sleep:#3498db;
    --blast:#e67e22;--border-radius:12px;
    --safe-top:env(safe-area-inset-top);--safe-bottom:env(safe-area-inset-bottom)
}
body{
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
    background:var(--bg-primary);color:var(--text-primary);
    min-height:100vh;overflow-x:hidden;-webkit-user-select:none;user-select:none
}
.screen{display:none;min-height:100vh;padding-bottom:calc(20px + var(--safe-bottom))}
.screen.active{display:block;animation:fadeIn .25s ease}
@keyframes fadeIn{from{opacity:0;transform:translateX(10px)}to{opacity:1;transform:translateX(0)}}

.home-header{text-align:center;padding:calc(60px + var(--safe-top)) 20px 30px;background:linear-gradient(180deg,#1a1a2e,#0f0f1a)}
.logo-icon{font-size:64px;display:block;margin-bottom:10px}
.home-header h1{font-size:28px;font-weight:800;background:linear-gradient(135deg,#e94560,#ff6b6b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.subtitle{color:var(--text-secondary);font-size:14px;margin-top:4px}
.home-menu{padding:10px 16px;display:flex;flex-direction:column;gap:12px}
.menu-card{display:flex;align-items:center;gap:14px;background:var(--bg-card);border:1px solid rgba(255,255,255,.05);border-radius:var(--border-radius);padding:18px 16px;cursor:pointer;transition:all .2s;text-align:left;color:var(--text-primary);font-family:inherit;width:100%}
.menu-card:active{background:var(--bg-card-hover);transform:scale(.98)}
.menu-card.disabled{opacity:.5;pointer-events:none}
.menu-icon{font-size:36px;flex-shrink:0}
.menu-card h2{font-size:17px;font-weight:600;margin-bottom:2px}
.menu-card p{font-size:13px;color:var(--text-secondary)}
.arrow{margin-left:auto;font-size:22px;color:var(--text-secondary)}
.badge{margin-left:auto;font-size:11px;background:var(--accent);color:#fff;padding:3px 8px;border-radius:20px;font-weight:600}
.home-footer{text-align:center;padding:30px 20px;color:var(--text-secondary);font-size:12px}

.top-bar{display:flex;align-items:center;gap:12px;padding:calc(12px + var(--safe-top)) 16px 12px;background:var(--bg-secondary);border-bottom:1px solid rgba(255,255,255,.05);position:sticky;top:0;z-index:100}
.top-bar h2{font-size:18px;font-weight:700;flex:1}
.back-btn{background:none;border:none;color:var(--accent);font-size:28px;cursor:pointer;padding:0 4px;font-weight:300}
.fav-btn{background:none;border:none;font-size:24px;cursor:pointer;padding:4px}
.spacer{width:32px}

.search-container{padding:12px 16px 0}
#search-input{width:100%;padding:12px 16px;background:var(--bg-card);border:1px solid rgba(255,255,255,.08);border-radius:10px;color:var(--text-primary);font-size:16px;outline:none;font-family:inherit}
#search-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-glow)}
#search-input::placeholder{color:var(--text-secondary)}

.filter-container{display:flex;gap:8px;padding:12px 16px;overflow-x:auto;-webkit-overflow-scrolling:touch}
.filter-container::-webkit-scrollbar{display:none}
.filter-btn{flex-shrink:0;padding:8px 16px;border-radius:20px;border:1px solid rgba(255,255,255,.1);background:var(--bg-card);color:var(--text-secondary);font-size:13px;font-weight:500;cursor:pointer;transition:all .2s;font-family:inherit}
.filter-btn.active{background:var(--accent);color:#fff;border-color:var(--accent)}

.monster-list{padding:8px 16px;display:flex;flex-direction:column;gap:8px}
.monster-card{display:flex;align-items:center;gap:14px;background:var(--bg-card);border:1px solid rgba(255,255,255,.05);border-radius:var(--border-radius);padding:14px 16px;cursor:pointer;transition:all .2s}
.monster-card:active{background:var(--bg-card-hover);transform:scale(.98)}
.monster-emoji{font-size:40px;flex-shrink:0;width:50px;text-align:center}
.monster-info{flex:1;min-width:0}
.monster-info h3{font-size:16px;font-weight:600;margin-bottom:3px}
.monster-type{font-size:12px;color:var(--text-secondary);margin-bottom:4px}
.monster-elements{display:flex;gap:4px;flex-wrap:wrap}
.element-badge{font-size:11px;padding:2px 8px;border-radius:10px;font-weight:500}
.element-badge.fire{background:rgba(255,107,53,.2);color:var(--fire)}
.element-badge.water{background:rgba(77,166,255,.2);color:var(--water)}
.element-badge.thunder{background:rgba(255,215,0,.2);color:var(--thunder)}
.element-badge.ice{background:rgba(135,206,235,.2);color:var(--ice)}
.element-badge.dragon{background:rgba(155,89,182,.2);color:var(--dragon)}
.element-badge.poison{background:rgba(142,68,173,.2);color:var(--poison)}
.element-badge.paralysis{background:rgba(241,196,15,.2);color:var(--paralysis)}
.element-badge.sleep{background:rgba(52,152,219,.2);color:var(--sleep)}
.element-badge.blast{background:rgba(230,126,34,.2);color:var(--blast)}

.detail-content{padding:16px}
.detail-header{text-align:center;padding:20px 0}
.detail-emoji{font-size:80px;display:block;margin-bottom:8px}
.detail-type{color:var(--text-secondary);font-size:14px}
.detail-section{background:var(--bg-card);border:1px solid rgba(255,255,255,.05);border-radius:var(--border-radius);padding:16px;margin-bottom:12px}
.detail-section h3{font-size:14px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;display:flex;align-items:center;gap:6px}
.weakness-table{width:100%;border-collapse:collapse}
.weakness-table td{padding:8px 4px;font-size:14px;border-bottom:1px solid rgba(255,255,255,.05)}
.weakness-table td:first-child{font-weight:500}
.weakness-table td:last-child{text-align:right}
.stars{letter-spacing:2px}
.stars.high{color:#2ecc71}.stars.medium{color:var(--thunder)}.stars.low{color:var(--accent)}.stars.none{color:var(--text-secondary)}
.parts-list,.locations-list{display:flex;flex-wrap:wrap;gap:6px}
.part-tag{background:rgba(233,69,96,.15);color:var(--accent);padding:5px 12px;border-radius:8px;font-size:13px;font-weight:500}
.location-tag{background:rgba(77,166,255,.15);color:var(--water);padding:5px 12px;border-radius:8px;font-size:13px;font-weight:500}
.strategy-text{font-size:14px;line-height:1.7;color:var(--text-primary)}
.strategy-text li{margin-bottom:8px;margin-left:16px}
.empty-state{text-align:center;padding:60px 20px;color:var(--text-secondary)}
.empty-icon{font-size:48px;display:block;margin-bottom:12px}
.empty-state p{font-size:16px;margin-bottom:6px}
.empty-state small{font-size:13px;opacity:.7}
